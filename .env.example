# =============================================================================
# slovo-propovedi-landing — environment variables
# =============================================================================
# Copy to `.env` for local dev (dev-server.mjs reads it; real environment
# wins over .env). There are NO production defaults baked into scripts,
# the Dockerfile or CI: every value below must be provided explicitly.
#
# In CI (Forgejo Actions) the production values are org/repo-level
# *Variables* (Settings → Actions → Variables): LANDING_HOSTNAME,
# WWW_HOSTNAME, WEB_HOSTNAME, DOCS_HOSTNAME, REPOSITORY_URL.
# On the VPS the timer-driven refresh scripts read them from
# /etc/default/slovo-landing (path overridable via ENV_FILE). That file is
# NOT created manually: the release workflow rewrites it on the VPS on
# every deploy, sourced from the org vars above.
# =============================================================================

# --- Required: hostnames (bare hostname: no protocol/path/port) ---
# Values below are the production values; in CI/on the VPS they come from
# the same-named org vars (see above).
# Landing apex domain — feeds og:url/og:image, QR, robots/sitemap baking.
LANDING_HOSTNAME=slovo-propovedi.ru
# www alias — 301-redirected to the apex by the deploy script's Traefik labels.
WWW_HOSTNAME=www.slovo-propovedi.ru
# Web app — target of the /web 302 redirect.
WEB_HOSTNAME=app.slovo-propovedi.ru
# Docs site — feeds the footer "API" link.
DOCS_HOSTNAME=docs.slovo-propovedi.ru

# --- Required: mobile repository coordinates (Forgejo org variables) ---
# Baked into the image (release links in index.html, release-host probes in
# main.js, CSP connect-src in nginx.conf) and used by the VPS refresh scripts.
# The dev server substitutes them too. Hosts are bare https origins (no path,
# no trailing slash); org/repo names are plain slugs. GitHub's hosts are fixed
# (api.github.com / raw.githubusercontent.com), only its org is configurable —
# note the GitHub org uses a hyphen where Forgejo/Codeberg use an underscore.
REPOSITORY_URL=https://git.lightnode.ru
REPOSITORY_ORG=Slovo_Propovedi
MIRROR_CODEBERG_URL=https://codeberg.org
MIRROR_CODEBERG_ORG=Slovo_Propovedi
MIRROR_GITHUB_ORG=Slovo-Propovedi
MOBILE_REPOSITORY_NAME=slovo-propovedi-mobile

# --- Required for VPS refresh scripts only (not needed for local dev) ---
# SHA-256 of the mobile release key's signing certificate (64 hex, as printed
# by `apksigner verify --print-certs`). The APK refresh publishes only APKs
# signed with it; comma-separate two digests during a key rotation. Public
# value (also in the mobile repo's public/.well-known/assetlinks.json).
APK_SIGNER_SHA256=43f8df039d37ade81a17b7ae8edf8e431c7fd87ba160fd8c09c6281a54706d9b

# --- Optional ---
# Dev server port (scripts/dev-server.mjs).
PORT=8377
